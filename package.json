{
  "name": "auth-pkce",
  "version": "0.0.4",
  "description": "OAuth 2.0 Authorization Code + PKCE for Node.js CLI applications",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "auth-pkce": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "dev": "npm run build && node dist/cli.js",
    "start": "node dist/cli.js",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:coverage": "npm run build && node --experimental-test-coverage --test test/*.test.cjs",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "build:examples": "npm run build && npm run build --prefix examples/ali-cli && npm run build --prefix examples/cli-integration",
    "smoke": "node examples/test-library.js && node examples/ali-cli/dist/cli.js hello --name Contributor",
    "package:check": "npm pack --dry-run",
    "verify": "npm run lint && npm run type-check && npm test && npm run build:examples && npm run smoke && npm run package:check",
    "prepublishOnly": "npm run lint && npm run type-check && npm test",
    "prepack": "npm run build"
  },
  "keywords": [
    "oauth2",
    "pkce",
    "authentication",
    "cli",
    "library",
    "nodejs",
    "openid-connect"
  ],
  "author": "Ali Shah <alishah730@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "inquirer": "^14.0.2",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alishah730/auth-pkce.git"
  },
  "bugs": {
    "url": "https://github.com/alishah730/auth-pkce/issues"
  },
  "homepage": "https://github.com/alishah730/auth-pkce#readme",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/alishah730"
  }
}
